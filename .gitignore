# --- build products and scratch -------------------------------------------------
build/
build-det/
*.o
*.com.dbg
*.aarch64.elf
gmon.out
fpuprobe.s
__pycache__/
*.pyc
*.tmp

# --- third-party, FETCHED not vendored ------------------------------------------
# v86/ is the read-only reference this port is defined against (and the source of
# gen/x86_table.js and the nasm corpus), so a clone must fetch it:
#     git clone --depth 1 https://github.com/copy/v86.git v86
v86/
oracle/node_modules/

# --- bulk evidence that a gate regenerates -------------------------------------
# The reports name the script that produces each of these; they are 10-26 MB apiece
# of boot diagnostics and saved emulator binaries, and committing them buys nothing
# a re-run does not.  The small evidence (transcripts, sha lists, mutation rigs,
# captures) stays.
results/**/boot-*-stderr.txt
results/**/*-det-run*-stderr.txt
results/**/v86c-base
results/**/v86c-chain
results/**/v86c-final
results/**/*.elf

# --- the 64 MiB test disk, MATERIALISED not tracked --------------------------------
# tests/images/disk-fmt-64m.img (67,108,864 bytes) crossed GitHub's 50 MB blob
# warning, so git tracks its xz -9 instead (tests/images/disk-fmt-64m.img.xz,
# 10,240 bytes) and tests/disk-fmt.sh materialises the raw file from it on first
# gate use, sha256-verified before it is put in place.  The raw image stays out of
# git from here on; the old 67 MB blob itself remains reachable in HISTORY (this
# change does not rewrite it).
tests/images/disk-fmt-64m.img
tests/images/disk-fmt-64m.img.tmp.*
