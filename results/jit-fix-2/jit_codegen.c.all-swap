	JC_R(instr_88_mem, "mov r/m8, r8 mem", MEM0, JIT_REC_MOV_RM8_R8, 0, true),
	JC_R(instr16_89_reg, "mov r/m16, r16 reg", REG0, JIT_REC_MOV_RM16_R16, 0, false),
	JC_R(instr16_89_mem, "mov r/m16, r16 mem", MEM0, JIT_REC_MOV_RM16_R16, 0, true),
	JC_R(instr16_8B_reg, "mov r16, r/m16 reg", REG0, JIT_REC_MOV_R16_RM16, 0, false),
	JC_R(instr16_8B_mem, "mov r16, r/m16 mem", MEM0, JIT_REC_MOV_R16_RM16, 0, true),
	/* lea: the memory form only (0x8D with mod == 3 is trigger_ud, a different body) */
