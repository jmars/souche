/*
 * jit_codegen.c -- THE BLOCK COMPILER: one decoded uop block -> one native x86-64 function.
 * See jit_codegen.h for the calling/execution contract and the aarch64 posture.
 *
 * ==================================================================== *
 * WHAT THE COMPILED BLOCK REPRODUCES, AND IN WHICH ORDER
 *
 * The contract is src/cpu/uop_cache.c's executor loop -- not a re-description of it.  For each
 * uop the executor does, in this order (uop_cache.c, the `for (;;)` inside the block run):
 *
 *   1. `if (uop_abort_pending) -> ABORT`          (the SMC abort, before ANY of the uop's work)
 *   2. `previous_ip = u->eip; instruction_pointer = u->body_ip; prefixes = u->pfx`
 *   3. `pagefault = false`                        (D1's dispatch-entry clear)
 *   4. the body (inline recipe, or the shape's C call), then `pagefault = false` again
 *   5. `prefixes = 0; pending += 1`
 *   6. `if (interpreted_unimplemented) { flush; RETURN }`
 *   7. `if (ran && (FLUSH || jit_block_boundary)) { flush; jbc = false; if budget RETURN }`
 *   8. `if the uop's page != the current page { flush; RETURN }`
 *   9. `if (pending >= LIMIT && eip >= ip) { flush; RETURN }`
 *  10. `if (BLOCK_END) { block_ends++; RETURN }`
 *  11. `if (u->eip + u->len != ip) -> TAIL`       (control flow left the block)
 *  12. otherwise the next uop
 *
 * Steps 6-11 are emitted ONCE PER BLOCK as a shared subroutine (`l_checks`), called at the end
 * of every uop with three registers describing that uop: EDI = the uop's flags (bit0 FLUSH,
 * bit1 BLOCK_END, bit2 "the body ran"), ESI = `u->eip + u->len` (the ip the fall-through path
 * must have) and R10D = `u->eip`.  It runs in the executor's order and returns only on the
 * fall-through path; every other outcome jumps to the block's exit stubs, which set the exit
 * kind in a frame slot and jump to the epilogue.
 *
 * ==================================================================== *
 * M2: THE FALLBACK IS THE C EXECUTOR ITSELF, AND THE RECIPES ARE INLINED
 *
 * M1 emitted the executor's per-shape call sequence (the guard, the address materialisation,
 * the argument mapping, the body call) INLINE, once per uop: ~190 bytes per called uop, of
 * which ~150 was the JIT's own bookkeeping.  MEASURED consequence (results/jit-1-m1.md ss4):
 * 190 of the boot's 740 blocks -- the hot ones, mean 47.4 uops, holding 99.7% of the boot's
 * dynamic executions -- did not fit in the 4 KiB code page and ran as uops, so only 0.32 % of
 * the boot ran compiled.
 *
 * M2 changes both halves of that:
 *
 *  (a) A uop with NO recipe is not expanded.  It becomes a 20-byte trampoline that loads the
 *      uop pointer and its flag word into the two argument registers and `call`s ONE shared
 *      per-block stub, which spills, calls `uop_exec_uop(u)` -- THE C EXECUTOR'S OWN per-uop
 *      worker (uop_cache.c) -- and reloads.  That is strictly MORE faithful than M1's
 *      transcription (one implementation of the shape switch, the guards and the
 *      materialisation instead of two) and it costs ~70 bytes per called uop instead of ~190.
 *  (b) A uop WITH a recipe is emitted inline, exactly (see the recipes below), and never calls
 *      the executor on the path that matters.
 *
 * The fit rule and the coverage measurement are the brief's G1; `results/jit-2-m2.md` has the
 * before/after numbers.
 *
 * ==================================================================== *
 * THE REGISTER CONTRACT (plan ss4.1) AND THE SPILL RULE
 *
 * Inside a compiled block: guest EAX/ECX/EDX/EBX/ESP/EBP/ESI/EDI live in RAX/RCX/RDX/RBX/
 * R12-R15; RBP holds `&cpu`; R8 holds `&jit_abort_flag`; R9 holds the pending count.  RSI,
 * RDI, R10 and R11 are free scratch at every point an emitter can reach (the checks routine's
 * arguments RSI/R10 are materialised at the END of each uop, after the body).
 *
 * THE SPILL RULE: before ANY C call the eight guest registers AND the pending count are stored
 * into cpu_state/the global, and after the call they are reloaded.  It is uniform (a per-call
 * cost, and calls are the fallback path) and it is what makes the C bodies work unchanged:
 * every `instr_XX_*` body reads and writes `cpu->reg32[]`, so the register file it sees must be
 * the live one.  A recipe needs no spill -- it operates on the host registers directly, and any
 * LATER call in the same block spills its result.
 *
 * THE STATE OF RECORD IS MEMORY, not the host registers: lazy-flag state, the segment bases,
 * EIP and the counters are all read and written through `cpu` exactly as the executor does, so
 * the two paths cannot disagree about them.  A compiled block is thus always in a state the C
 * code can be re-entered from at any of its exits.
 *
 * ==================================================================== *
 * AND WHAT IT DOES NOT DO.  It does not implement the reference's loop tail, the next-block
 * lookup, or the SMC re-decode: `jit_execute_block` returns and uop_run's existing C code does
 * all of it (jit_codegen.h).  That is the plan's central claim -- the compiled block returns
 * one of the executor's own outcomes and the parts not reimplemented cannot be wrong.
 */

#include "jit_codegen.h"

#include "jit_mem.h"

#include <stdio.h> /* the stats report, and the aarch64 stub's own line */

#if V86C_JIT_X64

#include <stddef.h>
#include <stdlib.h>
#include <string.h>

#include "cpu.h"          /* interpreted_unimplemented, jit_block_boundary, cpu_cycle_budget_end */
#include "cpu_state.h"    /* cpu_state_t, offsetof, the TLB_ and FLAG_ constants */
#include "instructions.h"   /* the recipe bodies, keyed by pointer */
#include "instructions_0f.h" /* the 0F-escape bodies (movzx, the rel32 jumps) */
#include "jit_x64.h"
#include "memory.h"  /* mem8 -- the data-address base */
#include "modrm.h"   /* PREFIX_MASK_SEGMENT, SEG_PREFIX_ZERO */
#include "paging.h"  /* tlb_data */
#include "uop_cache.h" /* uop_t, uop_pending, uop_stats, uop_exec_uop */

/* ------------------------------------------------------------------ *
 * the compile-time constants of the emitted block
 * ------------------------------------------------------------------ */

/* THE LOCAL FRAME, offsets from RSP.  The first three slots are M1's (the executed-uop count,
 * the inlined-uop count and the exit kind); the rest are M2's: the per-uop flag word the slow
 * trampoline hands the shared stub, and the four addresses the inlined memory recipes load
 * once per block instead of carrying in a register (there are only four scratch registers and
 * every one of them is live across the access).  56 bytes keeps RSP 16-byte aligned at every
 * emitted `call` (JIT_CODE_PAGE_BYTES is the buffer; this is the SysV stack rule). */
#define JC_FRAME_EXEC     0  /* 4: uops that ran (the executor's block_uops) */
#define JC_FRAME_INLINED  4  /* 4: ... of which ran as emitted code (the coverage split) */
#define JC_FRAME_KIND     8  /* 4: the exit kind, read by the epilogue */
#define JC_FRAME_FLAGS   12  /* 4: the per-uop flag word, in transit to the shared stub */
#define JC_FRAME_TLB     16  /* 8: (uintptr_t)tlb_data */
#define JC_FRAME_MEM8    24  /* 8: (uintptr_t)&mem8 -- the ADDRESS of the pointer, so the
                          * value is re-read per access and cannot go stale */
#define JC_FRAME_CODE    32  /* 8: uop_page_code's current value */
#define JC_FRAME_CODELEN 40  /* 4: uop_page_code_len */
#define JC_FRAME_BYTES   56

/* the state offsets, from offsetof() -- never hardcoded numbers */
#define JC_OFF(field) ((int32_t)offsetof(cpu_state_t, field))

/* THE GUEST REGISTER MAP (plan ss4.1).  Index order is cpu_state.h's own (EAX..EDI == 0..7). */
static const uint8_t jitcg_greg[8] = {
	JX_RAX, JX_RCX, JX_RDX, JX_RBX, JX_R12, JX_R13, JX_R14, JX_R15
};

#define JC_ABORT_REG JX_R8  /* &jit_abort_flag -- the SMC abort channel the compiled code reads */
#define JC_PENDING   JX_R9  /* the pending count, live across the block */
#define JC_TMP       JX_R11 /* scratch; also the shared stubs' function-pointer register */
#define JC_TMP2      JX_RSI /* scratch; the materialised physical address of a memory operand */
#define JC_VAL       JX_R10 /* the inlined operand's value register */

/* the per-uop flag word the checks routine reads (bit2 = "the body ran") */
#define JC_F_FLUSH     1
#define JC_F_BLOCK_END 2
#define JC_F_RAN       4

/* The scratch the block is emitted into.  ITS CAPACITY IS THE M2 FIT RULE (jit_mem.h): a block
 * that needs more than one code page gets as many contiguous 4 KiB pages as it needs, up to
 * JIT_CODE_MAX_BLOCK_BYTES; past that it is not compiled at all.  The emitter's overflow flag
 * is the test, so the emission cannot run past the buffer while discovering that. */
static uint8_t jitcg_scratch[JIT_CODE_MAX_BLOCK_BYTES];

jit_codegen_stats_t jit_codegen_stats;

/* the shared per-block labels and the state byte, for the recipe emitters.  The compile pass is
 * single-threaded and non-reentrant (jit_compile_block owns jitcg_scratch for the same
 * reason), so this is the emitter's context rather than a parameter of every recipe. */
typedef struct jitcg_shared {
	uint8_t state;     /* the uop cache's state byte -- cpl3 is constant-folded from it */
	int l_slow;        /* the shared C fallback (jitcg_emit_slow) */
	int getcf, getzf;  /* the shared lazy-flag getters (jitcg_emit_getcf/getzf) */
	bool has_getcf, has_getzf;
} jitcg_shared_t;

static jitcg_shared_t jitcg_sh;

/* ------------------------------------------------------------------ *
 * the recipe table
 * ------------------------------------------------------------------ */

/* ---- the operand helpers ---- */

static bool jc_mem_shape(uint8_t shape)
{
	return shape == UOP_SHAPE_MEM0 || shape == UOP_SHAPE_MEM1 ||
	       shape == UOP_SHAPE_MEMF0 || shape == UOP_SHAPE_MEMF1;
}

#define JC_MAX_RECIPES 192

/* a state cell / a register / a guest register, as an operand.  These are macros over a
 * COMPOUND LITERAL rather than functions: the emitters take `const jx_operand_t *`, and they
 * are called in expressions where a local would be pure noise. */
#define jc_reg(r_) (&(jx_operand_t){ false, (r_), -1, 0, 0 })
#define jc_state(off_) (&(jx_operand_t){ true, JX_RBP, -1, 0, (off_) })
#define jc_greg(g_) (&(jx_operand_t){ false, jitcg_greg[(g_)], -1, 0, 0 })
#define jc_mem(b_, i_, s_, d_) (&(jx_operand_t){ true, (b_), (i_), (s_), (d_) })

/* THE BYTE VIEW OF THE REGISTER FILE (cpu_state.c:19-30), which is NOT "the byte register
 * of the same index":
 *
 *     get_reg8_index(i) = (i << 2 & 12) | (i >> 2 & 1)      ->     0,4,8,12,1,5,9,13
 *
 * so register i's byte lives in reg32[i & 3] at byte (i >> 2 & 1) -- AL/CL/DL/BL for 0..3 and
 * AH/CH/DH/BH for 4..7, i.e. the HIGH byte of EAX/ECX/EDX/EBX.  MEASURED, and it cost a 16 KiB
 * serial flood rather than a wrong digit: writing AH into reg32[4]'s high byte (ESP's) instead
 * of reg32[0]'s corrupted the guest's stack pointer, and the boot firmware then printed one
 * message forever. */
static inline int jc_reg8_host(int guest) { return jitcg_greg[guest & 3]; }
static inline bool jc_reg8_high(int guest) { return guest >= 4; }

/* read_reg8(i), zero-extended into `dst` */
static void jitcg_emit_read_reg8(jx64_t *e, int dst, int guest)
{
	int h = jc_reg8_host(guest);
	if (!jc_reg8_high(guest)) {
		jx64_movzx_r32_r8(e, dst, h);
	}
	else {
		/* AH..BH are bits 8..15 of the 32-bit register, and REX makes the H registers
		 * unaddressable, so the byte is extracted with a shift */
		jx64_mov_r32_r32(e, dst, h);
		jx64_shr_r32_imm8(e, dst, 8);
		/* THE MASK MUST BE THE imm32 FORM (`81 /4 id`).  The imm8 form
		 * (`83 /4 ib`, imm8 == true) SIGN-EXTENDS the byte: 0xFF becomes
		 * 0xFFFFFFFF, the AND is a no-op, and the 24 bits the shift left in
		 * bits 8..31 survive -- measured: `movzx esi, ah` on EAX=0x9ABCDEF0
		 * gave 0x009ABCDE instead of 0xDE. */
		jx64_alu_rm_imm(e, 4 /* and */, jc_reg(dst), 0xFF, false);
	}
}

/* write_reg8(i, value) -- only the low byte of `src` is used, `tmp` is scratch
 *
 * The `and tmp, 0xFF` below is the imm32 form for the SAME reason as the reader's (see
 * jitcg_emit_read_reg8): the imm8 form sign-extends 0xFF, masks nothing, and lets `src`'s bits
 * 8..23 reach the destination's bits 16..31 through the shift.
 *
 * WHETHER THIS SITE IS LIVE DEPENDS ON THE READER, and all four states were MEASURED
 * (results/jit-fix-1.md, G1's four arms; `mov ah, bh` on EAX = 0x1111C0DE, EBX = 0x22223456):
 *
 *   reader dead + this dead  -> 0x333334DE   WRONG  <- the tree as shipped and reviewed
 *   reader dead + this fixed -> 0x111134DE   right
 *   reader fixed + this dead -> 0x111134DE   right
 *   reader fixed + this fixed-> 0x111134DE   right
 *
 * So it IS reachable with a non-zero source -- the reader hands it its unmasked 24-bit value --
 * but it cannot be reached INDEPENDENTLY of the reader: every caller passes JC_VAL, and every
 * JC_VAL producer zero-extends, which is what makes this mask dead weight once the reader is
 * fixed.  Two independent reviews of this unit disagreed about this site (one called it a live
 * blocker, the probe that first measured it called it correct because its cases used a LOW-byte
 * source, whose reader arm was never broken); the measurement above is what settles it:
 * `mov ah, bl` correct / `mov ah, bh` wrong is a property of the SOURCE, not of this helper. */
static void jitcg_emit_write_reg8(jx64_t *e, int guest, int src, int tmp)
{
	int h = jc_reg8_host(guest);
	if (!jc_reg8_high(guest)) {
		jx64_mov_r8_r8(e, h, src);
	}
	else {
		jx64_alu_rm_imm(e, 4, jc_reg(h), ~0xFF00, false); /* keep bits 0..7 and 16..31 */
		jx64_mov_r32_r32(e, tmp, src);
		jx64_alu_rm_imm(e, 4, jc_reg(tmp), 0xFF, false);
		jx64_shl_r32_imm8(e, tmp, 8);
		jx64_or_r32_r32(e, h, tmp);
	}
}

/* ------------------------------------------------------------------ *
 * the inlined memory operand: address, translation, the gates, the access
 *
 * Every gate below is a transcription of the C helper the uop would otherwise call, and EVERY
 * one of them jumps to the shared fallback instead of being finished here -- which is always
 * correct, because the fallback re-runs the whole C body from the uop's own decoded fields.
 * The gates, and the site each comes from:
 *
 *   the page-end straddle   safe_read{16,32s} / safe_write{16,32}: the C splits the access in
 *                           two and translates each half, so a straddling access is not a
 *                           single physical access at all (reads: paging.c:517-566)
 *   the TLB miss            translate_address (paging.c:275-292): the entry does not satisfy
 *                           the requested access's bits, so a walk (with side effects) is due
 *   the device/mapped range safe_read and safe_write in_mapped_range test (memory.h:93-96)
 *   a store to a code page  the C body's OWN invalidate hook (uop_invalidate_page_fast at
 *                           paging.h:197-221, and paging.c safe_write): the recipe must not
 *                           re-implement it, and a data page -- the common case -- is exactly
 *                           the page the hook would skip, so this gate is equivalent
 *   the null segment        uop_seg_base (uop_cache.c:372-395): raises the #GP
 * ------------------------------------------------------------------ */

enum { JC_W32 = 32, JC_W16 = 16, JC_W8 = 8 };

/* the linear address of a memory operand, in `dst`.  `with_seg` is false for 0x8D (lea), whose
 * body forces SEG_PREFIX_ZERO and therefore never adds a segment base at all. */
static void jitcg_emit_addr(jx64_t *e, const uop_t *u, int dst, bool with_seg, int l_slow)
{
	int base = u->base == UOP_REG_NONE ? -1 : (int)jitcg_greg[u->base];
	int index = u->index == UOP_REG_NONE ? -1 : (int)jitcg_greg[u->index];
	uint8_t seg = u->seg;
	int pseg;

	jx64_lea_r32_rm(e, dst, jc_mem(base, index, (int)u->scale, (int32_t)u->disp));

	if (!with_seg) return;

	pseg = (int)(u->pfx & PREFIX_MASK_SEGMENT);
	if (pseg == SEG_PREFIX_ZERO) return; /* the address is unsegmented by construction */
	if (pseg != 0) seg = (uint8_t)(pseg - 1);

	jx64_cmp_m8_imm8(e, JX_RBP, JC_OFF(segment_is_null) + (int32_t)seg, 0);
	jx64_jcc_label(e, JX_CC_NE, l_slow);
	jx64_alu_r32_rm(e, 0 /* add */, dst, jc_state(JC_OFF(segment_offsets) + 4 * (int32_t)seg));
}

/* materialise the physical address in JC_TMP2 and the mem8 base in JC_TMP.  `write` selects
 * the C helper's translation (translate_address_write_and_can_skip_dirty vs
 * translate_address_read -- paging.c:275-315 vs :259-273, whose only difference is TLB_READONLY
 * in the entry test). */
static void jitcg_emit_mem_prep(jx64_t *e, const uop_t *u, int width, bool write, int l_slow)
{
	int mask = TLB_VALID | ((jitcg_sh.state & CACHED_MASK_CPL3) ? TLB_NO_USER : 0) |
	           (write ? TLB_READONLY : 0);

	jitcg_emit_addr(e, u, JC_TMP, true, l_slow);

	/* the page-end straddle (see the header block).  A byte access never straddles. */
	if (width != JC_W8) {
		jx64_mov_r32_r32(e, JX_RDI, JC_TMP);
		jx64_alu_rm_imm(e, 4, jc_reg(JX_RDI), 0xFFF, false);
		jx64_cmp_r32_imm32(e, JX_RDI, width == JC_W16 ? 0xFFF : 0xFFD);
		jx64_jcc_label(e, JX_CC_AE, l_slow);
	}

	/* the TLB fast path: entry = tlb_data[addr >> 12]; (entry & mask) == TLB_VALID */
	jx64_mov_r32_r32(e, JC_TMP2, JC_TMP);
	jx64_shr_r32_imm8(e, JC_TMP2, 12);
	/* THE LINEAR ADDRESS LIVES IN JC_TMP UNTIL THE FINAL XOR, so the tlb_data pointer goes in
	 * JX_RDI (which the mask test below reloads anyway).  MEASURED, and it is why the matrix's
	 * every memory case refused to inline: loading tlb_data into JC_TMP destroyed the address,
	 * and `phys` came out as `entry ^ (tlb_data & 0xFFFFFFFF)` -- far above memory_size, so the
	 * plain-RAM gate took every access.
	 *
	 * SCALE 2 == x4: tlb_data is an int32_t[] indexed by a page number. */
	jx64_mov_r64_m64(e, JX_RDI, JX_RSP, JC_FRAME_TLB);
	jx64_mov_r32_rm(e, JC_TMP2, jc_mem(JX_RDI, JC_TMP2, 2, 0));
	jx64_mov_r32_r32(e, JX_RDI, JC_TMP2);
	jx64_alu_rm_imm(e, 4, jc_reg(JX_RDI), mask, true);
	jx64_cmp_r32_imm32(e, JX_RDI, TLB_VALID);
	jx64_jcc_label(e, JX_CC_NE, l_slow);

	/* phys = (entry & ~0xFFF) ^ addr (the guest physical address -- paging.c:291-294) */
	jx64_alu_rm_imm(e, 4, jc_reg(JC_TMP2), ~0xFFF, false);
	jx64_xor_r32_r32(e, JC_TMP2, JC_TMP);

	/* in_mapped_range(phys): >= memory_size, or inside the 0xA0000..0xC0000 device window */
	jx64_alu_r32_rm(e, 7 /* cmp */, JC_TMP2, jc_state(JC_OFF(memory_size)));
	jx64_jcc_label(e, JX_CC_AE, l_slow);
	jx64_lea_r32_rm(e, JX_RDI, jc_mem(JC_TMP2, -1, 0, (int32_t)-0xA0000));
	jx64_cmp_r32_imm32(e, JX_RDI, 0x20000);
	jx64_jcc_label(e, JX_CC_B, l_slow);

	if (write) {
		/* a write to a page that holds decoded or compiled code belongs to the C body,
		 * whose own hook drops the block and raises the abort -- and that is the whole
		 * reason the emitted fast path never has to call anything */
		int l_ok = jx64_label(e);
		jx64_mov_r32_r32(e, JX_RDI, JC_TMP2);
		jx64_shr_r32_imm8(e, JX_RDI, 12);
		/* THE FRAME IS RSP-RELATIVE (jc_mem(JX_RSP, ...)), NOT cpu_state (jc_state).  MEASURED:
		 * reading the length at `rbp + JC_FRAME_CODELEN` (which is cpu->last_op1) made the
		 * comparison against the page number meaningless, so a store to a page that HOLDS CODE
		 * could skip the invalidate-and-re-decode the C body owns -- stale code executing, the
		 * PERF-FIX-3 blocker the plan's ss4 exists to keep shut -- and cost the 200 M boot its
		 * final state. */
		jx64_alu_r32_rm(e, 7 /* cmp */, JX_RDI, jc_mem(JX_RSP, -1, 0, JC_FRAME_CODELEN));
		jx64_jcc_label(e, JX_CC_AE, l_ok);
		jx64_mov_r64_m64(e, JC_TMP, JX_RSP, JC_FRAME_CODE);
		jx64_movzx_r32_rm8(e, JX_RDI, jc_mem(JC_TMP, JX_RDI, 0, 0));
		jx64_test_r32_r32(e, JX_RDI, JX_RDI);
		jx64_jcc_label(e, JX_CC_NE, l_slow);
		jx64_bind(e, l_ok);
	}

	/* JC_TMP = mem8 (re-read through the pointer's own address, so it cannot go stale) */
	jx64_mov_r64_m64(e, JC_TMP, JX_RSP, JC_FRAME_MEM8);
	jx64_mov_r64_m64(e, JC_TMP, JC_TMP, 0);
}

/* the operand an inlined memory access reads or writes: mem8 base in JC_TMP, phys in JC_TMP2 */
#define jitcg_mem_operand() jc_mem(JC_TMP, JC_TMP2, 0, 0)

static void jitcg_emit_mem_load(jx64_t *e, const uop_t *u, int dst, int width, int l_slow)
{
	jitcg_emit_mem_prep(e, u, width, false, l_slow);
	if (width == JC_W32) jx64_mov_r32_rm(e, dst, jitcg_mem_operand());
	else if (width == JC_W16) jx64_movzx_r32_rm16(e, dst, jitcg_mem_operand());
	else jx64_movzx_r32_rm8(e, dst, jitcg_mem_operand());
}

static void jitcg_emit_mem_store(jx64_t *e, const uop_t *u, int src, int width, int l_slow)
{
	jitcg_emit_mem_prep(e, u, width, true, l_slow);
	if (width == JC_W32) jx64_mov_rm_r32(e, jitcg_mem_operand(), src);
	else if (width == JC_W16) jx64_mov_rm16_r16(e, jitcg_mem_operand(), src);
	else jx64_mov_rm8_r8(e, jitcg_mem_operand(), src);
}

/* the recipe's FIRST operand (the r/m one), loaded into `dst` / written from `src` */
static void jitcg_emit_op_load(jx64_t *e, const uop_t *u, int dst, int width, int l_slow)
{
	if (jc_mem_shape(u->shape)) {
		jitcg_emit_mem_load(e, u, dst, width, l_slow);
		return;
	}
	if (width == JC_W32) jx64_mov_r32_r32(e, dst, jitcg_greg[u->modrm & 7]);
	else if (width == JC_W16) jx64_movzx_r32_rm16(e, dst, jc_greg(u->modrm & 7));
	else jitcg_emit_read_reg8(e, dst, (int)(u->modrm & 7));
}

static void jitcg_emit_op_store(jx64_t *e, const uop_t *u, int src, int width, int l_slow)
{
	if (jc_mem_shape(u->shape)) {
		jitcg_emit_mem_store(e, u, src, width, l_slow);
		return;
	}
	if (width == JC_W32) jx64_mov_r32_r32(e, jitcg_greg[u->modrm & 7], src);
	else if (width == JC_W16) jx64_mov_rm16_r16(e, jc_greg(u->modrm & 7), src);
	else jitcg_emit_write_reg8(e, (int)(u->modrm & 7), src, JC_TMP);
}

/* ------------------------------------------------------------------ *
 * the lazy-flag writers
 *
 * flags.c:97-178 and arith.c:396-422, transcribed.  The STATE IS MEMORY (cpu->flags_changed /
 * last_op1 / last_result / last_op_size), which is what makes the two engines unable to
 * disagree about it: nothing is cached in a host register across a uop.
 * ------------------------------------------------------------------ */

/* flags_add / flags_sub (flags.c:97-136): last_op1 is the DESTINATION's value and must be
 * stored BEFORE the result overwrites it.  `digit` 0 == add, 5 == sub, 7 == cmp (sub with no
 * write-back); cmp and sub differ only in the caller's use of the result. */
static void jitcg_emit_flags_addsub_reg(jx64_t *e, int digit, int dst, int src)
{
	jx64_mov_m32_r32(e, JX_RBP, JC_OFF(last_op1), dst);
	jx64_alu_rm_r32(e, digit, jc_reg(dst), src);
	jx64_mov_m32_r32(e, JX_RBP, JC_OFF(last_result), dst);
	jx64_mov_m32_imm32(e, JX_RBP, JC_OFF(last_op_size), OPSIZE_32);
	jx64_mov_m32_imm32(e, JX_RBP, JC_OFF(flags_changed),
	                   (uint32_t)(int32_t)(FLAGS_ALL | (digit == 0 ? 0 : FLAG_SUB)));
}

static void jitcg_emit_flags_addsub_imm(jx64_t *e, int digit, int dst, int32_t imm, bool imm8)
{
	jx64_mov_m32_r32(e, JX_RBP, JC_OFF(last_op1), dst);
	jx64_alu_rm_imm(e, digit, jc_reg(dst), imm, imm8);
	jx64_mov_m32_r32(e, JX_RBP, JC_OFF(last_result), dst);
	jx64_mov_m32_imm32(e, JX_RBP, JC_OFF(last_op_size), OPSIZE_32);
	jx64_mov_m32_imm32(e, JX_RBP, JC_OFF(flags_changed),
	                   (uint32_t)(int32_t)(FLAGS_ALL | (digit == 0 ? 0 : FLAG_SUB)));
}

/* arith_and / arith_or / arith_xor (arith.c:396-422): NO last_op1 store, and CF/OF/AF are
 * materialised in `flags` (they are cleared in flags_changed, so the getters read them back
 * from there).  `digit` 1 == or, 4 == and, 6 == xor. */
#define JC_LOGIC_MASK   ((int32_t)~(FLAG_CARRY | FLAG_OVERFLOW | FLAG_ADJUST))

static void jitcg_emit_flags_logic_tail(jx64_t *e, int dst);

static void jitcg_emit_flags_logic_reg(jx64_t *e, int digit, int dst, int src)
{
	jx64_alu_rm_r32(e, digit, jc_reg(dst), src);
	jitcg_emit_flags_logic_tail(e, dst);
}

/* The scratch here is JX_RDI, NOT JC_TMP2: JC_TMP2 is the materialised PHYSICAL ADDRESS of a
 * read-modify-write operand and must survive the flag update between the load and the store.
 * MEASURED (the matrix's `or [m]`/`xor [m]` cases): with JC_TMP2 the store wrote to
 * `mem8 + (the flags word)` -- a wild write that the RAM comparison caught. */
static void jitcg_emit_flags_logic_tail(jx64_t *e, int dst)
{
	jx64_mov_m32_r32(e, JX_RBP, JC_OFF(last_result), dst);
	jx64_mov_m32_imm32(e, JX_RBP, JC_OFF(last_op_size), OPSIZE_32);
	jx64_mov_r32_rm(e, JX_RDI, jc_state(JC_OFF(flags)));
	jx64_alu_rm_imm(e, 4, jc_reg(JX_RDI), JC_LOGIC_MASK, false);
	jx64_mov_m32_r32(e, JX_RBP, JC_OFF(flags), JX_RDI);
	jx64_mov_m32_imm32(e, JX_RBP, JC_OFF(flags_changed), (uint32_t)(FLAGS_ALL & JC_LOGIC_MASK));
}

static void jitcg_emit_flags_logic_imm(jx64_t *e, int digit, int dst, int32_t imm, bool imm8)
{
	jx64_alu_rm_imm(e, digit, jc_reg(dst), imm, imm8);
	jitcg_emit_flags_logic_tail(e, dst);
}

/* flags_inc / flags_dec (flags.c:156-178): CF is PRESERVED, so the lazy carry is materialised
 * into `flags` first -- through the shared getcf routine, which is not a C call. */
static void jitcg_emit_flags_incdec(jx64_t *e, int dst, bool dec)
{
	jx64_call_label(e, jitcg_sh.getcf); /* EDI = CF as 0/1 */
	jx64_mov_r32_rm(e, JC_TMP2, jc_state(JC_OFF(flags)));
	jx64_alu_rm_imm(e, 4, jc_reg(JC_TMP2), ~1, false);
	jx64_or_r32_r32(e, JC_TMP2, JX_RDI);
	jx64_mov_m32_r32(e, JX_RBP, JC_OFF(flags), JC_TMP2);

	jx64_mov_m32_r32(e, JX_RBP, JC_OFF(last_op1), dst);
	if (dec) jx64_dec_r32(e, dst);
	else jx64_inc_r32(e, dst);
	jx64_mov_m32_r32(e, JX_RBP, JC_OFF(last_result), dst);
	jx64_mov_m32_imm32(e, JX_RBP, JC_OFF(last_op_size), OPSIZE_32);
	jx64_mov_m32_imm32(e, JX_RBP, JC_OFF(flags_changed),
	                   (uint32_t)(int32_t)((FLAGS_ALL & ~1) | (dec ? FLAG_SUB : 0)));
}

/* ------------------------------------------------------------------ *
 * the recipes
 *
 * Each one is a transcription of ONE body (or one family, where the encodings share a body
 * shape and differ only in a digit and a flag bit) and each one writes the same
 * cpu_state/guest-register state the body writes, in the same order.  A recipe that cannot
 * complete jumps to jitcg_sh.l_slow; one that cannot fail never allocates the label at all
 * (jit_recipe_t.slow), which is what keeps the common uops small.
 * ------------------------------------------------------------------ */

/* mov r/m32, r32 -- 0x89 (instr32_89_reg/_mem) */
static void rec_mov_rm_r32(jx64_t *e, const uop_t *u, int l_slow)
{
	if (jc_mem_shape(u->shape)) jitcg_emit_mem_store(e, u, jitcg_greg[u->g], JC_W32, l_slow);
	else jx64_mov_r32_r32(e, jitcg_greg[u->modrm & 7], jitcg_greg[u->g]);
}

/* mov r32, r/m32 -- 0x8B (instr32_8B_reg/_mem) */
static void rec_mov_r32_rm(jx64_t *e, const uop_t *u, int l_slow)
{
	if (jc_mem_shape(u->shape)) jitcg_emit_mem_load(e, u, jitcg_greg[u->g], JC_W32, l_slow);
	else jx64_mov_r32_r32(e, jitcg_greg[u->g], jitcg_greg[u->modrm & 7]);
}

/* movzx r32, r/m8 -- 0F B6 (instructions_0f.c) */
static void rec_movzx_r8(jx64_t *e, const uop_t *u, int l_slow)
{
	if (jc_mem_shape(u->shape)) jitcg_emit_mem_load(e, u, jitcg_greg[u->g], JC_W8, l_slow);
	else jitcg_emit_read_reg8(e, jitcg_greg[u->g], (int)(u->modrm & 7));
}

/* movzx r32, r/m16 -- 0F B7 */
static void rec_movzx_r16(jx64_t *e, const uop_t *u, int l_slow)
{
	if (jc_mem_shape(u->shape)) jitcg_emit_mem_load(e, u, jitcg_greg[u->g], JC_W16, l_slow);
	else jx64_movzx_r32_rm16(e, jitcg_greg[u->g], jc_greg(u->modrm & 7));
}

/* mov r8, r/m8 -- 0x8A (instr_8A_reg/_mem): the destination is always the REGISTER `g` */
static void rec_mov_r8_rm8(jx64_t *e, const uop_t *u, int l_slow)
{
	if (jc_mem_shape(u->shape)) {
		jitcg_emit_mem_load(e, u, JC_VAL, JC_W8, l_slow);
		jitcg_emit_write_reg8(e, (int)u->g, JC_VAL, JC_TMP);
	}
	else {
		jitcg_emit_read_reg8(e, JC_VAL, (int)(u->modrm & 7));
		jitcg_emit_write_reg8(e, (int)u->g, JC_VAL, JC_TMP);
	}
}

/* mov r/m8, r8 -- 0x88 (instr_88_reg/_mem) */
static void rec_mov_rm8_r8(jx64_t *e, const uop_t *u, int l_slow)
{
	jitcg_emit_read_reg8(e, JC_VAL, (int)u->g);
	jitcg_emit_op_store(e, u, JC_VAL, JC_W8, l_slow);
}

/* mov r/m16, r16 -- 0x89 with 0x66 (instr16_89_reg/_mem) */
static void rec_mov_rm16_r16(jx64_t *e, const uop_t *u, int l_slow)
{
	jitcg_emit_op_store(e, u, jitcg_greg[u->g], JC_W16, l_slow);
}

/* mov r16, r/m16 -- 0x8B with 0x66 (instr16_8B_reg/_mem) */
static void rec_mov_r16_rm16(jx64_t *e, const uop_t *u, int l_slow)
{
	if (jc_mem_shape(u->shape)) {
		jitcg_emit_mem_load(e, u, JC_VAL, JC_W16, l_slow);
		jx64_mov_rm16_r16(e, jc_greg((int)u->g), JC_VAL);
	}
	else {
		jx64_movzx_r32_rm16(e, JC_VAL, jc_greg(u->modrm & 7));
		jx64_mov_rm16_r16(e, jc_greg((int)u->g), JC_VAL);
	}
}

/* lea r32, m -- 0x8D (instr32_8D_mem).  The body ORs SEG_PREFIX_ZERO into cpu->prefixes before
 * modrm_resolve, so the segment base is NOT added and the whole instruction is the offset sum:
 * the recipe is the decoder's own extracted fields and cannot fault. */
static void rec_lea(jx64_t *e, const uop_t *u, int l_slow)
{
	(void)l_slow;
	jitcg_emit_addr(e, u, jitcg_greg[u->g], false, l_slow);
	/* modrm_resolve (which the body runs on the RAW modrm byte) CONSUMES the sib/disp, so the
	 * body leaves the instruction pointer at the instruction's END -- the executor's own
	 * body_ip for this uop is the position just after the modrm byte (uop_cache.c:614), so
	 * the recipe must advance it as the body does or the divergence test reads a control
	 * transfer that never happened.  MEASURED: without this, a `lea` inside a block sent the
	 * next lookup to eip + pfx_len + opcode_bytes + 1 and a second block was decoded from the
	 * middle of the lea (the codegen selftest's shapes-B arm). */
	jx64_mov_m32_imm32(e, JX_RBP, JC_OFF(instruction_pointer),
	                   u->eip + (uint32_t)u->len);
}

/* the group-1 ALU family: `<digit> r/m32, r32` (0x01/09/21/29/31/39) and the immediate forms
 * (0x81/0x83).  `digit` 0 add, 1 or, 4 and, 5 sub, 6 xor, 7 cmp.  2/3 (adc/sbb) read the lazy
 * carry and are NOT recipes: they fall back to the C body. */
static void jitcg_emit_alu_rm(jx64_t *e, const uop_t *u, int l_slow, int digit, bool is_imm,
                             int32_t imm, bool imm8)
{
	/* digit 7 is `cmp`: the OPCODE writes nothing back, but the FLAGS are flags_sub's -- so
	 * the arithmetic is the sub opcode on the copy, and only the write-back is dropped.
	 * Getting this wrong is silent and data-dependent (MEASURED: storing the unmodified
	 * operand in last_result made every `jb` after a `cmp` read CF as if the difference were
	 * positive, which cost the M0 transcript and the 200 M boot). */
	int op = digit == 7 ? 5 : digit;
	bool wb = digit != 7; /* cmp writes nothing back */
	bool logic = digit == 1 || digit == 4 || digit == 6;

	if (jc_mem_shape(u->shape) && wb) {
		/* the C's SAFE_READ_WRITE32: ONE translate for the read AND the write */
		jitcg_emit_mem_prep(e, u, JC_W32, true, l_slow);
		const jx_operand_t *m = jitcg_mem_operand();
		jx64_mov_r32_rm(e, JC_VAL, m);
		if (is_imm) {
			if (logic) jitcg_emit_flags_logic_imm(e, op, JC_VAL, imm, imm8);
			else jitcg_emit_flags_addsub_imm(e, op, JC_VAL, imm, imm8);
		}
		else {
			if (logic) jitcg_emit_flags_logic_reg(e, op, JC_VAL, jitcg_greg[u->g]);
			else jitcg_emit_flags_addsub_reg(e, op, JC_VAL, jitcg_greg[u->g]);
		}
		jx64_mov_rm_r32(e, m, JC_VAL);
	}
	else {
		jitcg_emit_op_load(e, u, JC_VAL, JC_W32, l_slow);
		if (is_imm) {
			if (logic) jitcg_emit_flags_logic_imm(e, op, JC_VAL, imm, imm8);
			else jitcg_emit_flags_addsub_imm(e, op, JC_VAL, imm, imm8);
		}
		else {
			if (logic) jitcg_emit_flags_logic_reg(e, op, JC_VAL, jitcg_greg[u->g]);
			else jitcg_emit_flags_addsub_reg(e, op, JC_VAL, jitcg_greg[u->g]);
		}
		if (wb) jitcg_emit_op_store(e, u, JC_VAL, JC_W32, l_slow);
	}
}

/* test r/m32, r32 -- 0x85: arith_and with no write-back, no last_op1 */
static void rec_test_rm_r32(jx64_t *e, const uop_t *u, int l_slow)
{
	if (jc_mem_shape(u->shape)) jitcg_emit_mem_load(e, u, JC_VAL, JC_W32, l_slow);
	else jx64_mov_r32_r32(e, JC_VAL, jitcg_greg[u->modrm & 7]);
	jitcg_emit_flags_logic_reg(e, 4 /* and */, JC_VAL, jitcg_greg[u->g]);
}

/* test r/m32, imm32 -- F7 /0 */
static void rec_test_rm_imm32(jx64_t *e, const uop_t *u, int l_slow)
{
	jitcg_emit_op_load(e, u, JC_VAL, JC_W32, l_slow);
	jitcg_emit_flags_logic_imm(e, 4, JC_VAL, u->imm, false);
}

/* test r/m8, imm8 -- F6 /0: the same arith_and with OPSIZE_8 */
static void rec_test_rm8_imm8(jx64_t *e, const uop_t *u, int l_slow)
{
	jitcg_emit_op_load(e, u, JC_VAL, JC_W8, l_slow);
	jx64_alu_rm_imm(e, 4, jc_reg(JC_VAL), u->imm & 0xFF, true);
	jx64_mov_m32_r32(e, JX_RBP, JC_OFF(last_result), JC_VAL);
	jx64_mov_m32_imm32(e, JX_RBP, JC_OFF(last_op_size), OPSIZE_8);
	jx64_mov_r32_rm(e, JC_TMP2, jc_state(JC_OFF(flags)));
	jx64_alu_rm_imm(e, 4, jc_reg(JC_TMP2), JC_LOGIC_MASK, false);
	jx64_mov_m32_r32(e, JX_RBP, JC_OFF(flags), JC_TMP2);
	jx64_mov_m32_imm32(e, JX_RBP, JC_OFF(flags_changed), (uint32_t)(FLAGS_ALL & JC_LOGIC_MASK));
}

/* not r/m32 -- F7 /2 (arith.c: `~x`, no flags at all) */
static void rec_not_rm32(jx64_t *e, const uop_t *u, int l_slow)
{
	if (jc_mem_shape(u->shape)) {
		jitcg_emit_mem_prep(e, u, JC_W32, true, l_slow);
		const jx_operand_t *m = jitcg_mem_operand();
		jx64_mov_r32_rm(e, JC_VAL, m);
		jx64_not_r32(e, JC_VAL);
		jx64_mov_rm_r32(e, m, JC_VAL);
	}
	else {
		jx64_mov_r32_r32(e, JC_VAL, jitcg_greg[u->modrm & 7]);
		jx64_not_r32(e, JC_VAL);
		jx64_mov_r32_r32(e, jitcg_greg[u->modrm & 7], JC_VAL);
	}
}

/* inc/dec r32 -- 0x40-0x4F: the register is baked into the body, so one recipe per encoding */
static void rec_incdec_reg(jx64_t *e, const uop_t *u, int l_slow, int guest, bool dec)
{
	(void)u; (void)l_slow;
	jx64_mov_r32_r32(e, JC_VAL, jitcg_greg[guest]);
	jitcg_emit_flags_incdec(e, JC_VAL, dec);
	jx64_mov_r32_r32(e, jitcg_greg[guest], JC_VAL);
}

/* mov r32, imm32 -- 0xB8+r: one recipe per encoding (the register is in the body) */
static void rec_mov_r32_imm32(jx64_t *e, const uop_t *u, int l_slow, int guest)
{
	(void)l_slow;
	jx64_mov_r32_imm32(e, jitcg_greg[guest], (uint32_t)u->imm);
}

/* nop -- 0x90 */
static void rec_nop(jx64_t *e, const uop_t *u, int l_slow) { (void)e; (void)u; (void)l_slow; }

/* the conditional jumps -- 0x70-0x7F (rel8) and 0F 80-8F (rel32).
 *
 * The condition is evaluated by the SHARED per-block getters (jitcg_emit_getcf/getzf, which are
 * emitted code, not calls into flags.c); a taken jump stores the target the C body would store
 * and then FALLS THROUGH to the same tail as an untaken one, so the executor's own step 11 sees
 * the divergence and exits TAIL.  `cc` is the low nibble of the opcode. */
static void rec_jcc(jx64_t *e, const uop_t *u, int l_slow, int cc)
{
	int l_skip = jx64_label(e);
	int not_taken;

	(void)l_slow;
	switch (cc) {
	case JX_CC_B:
	case JX_CC_AE:
		jx64_call_label(e, jitcg_sh.getcf);
		break;
	case JX_CC_E:
	case JX_CC_NE:
		jx64_call_label(e, jitcg_sh.getzf);
		break;
	default: /* BE == CF|ZF, A == !(CF|ZF): TWO getters, and the first result must survive the
	          * second call.  It goes in JC_VAL (R10), NOT in JC_TMP (R11): the getzf stub uses
	          * R11 for the lazy shift count, so saving CF there ORs it with last_op_size.
	          * MEASURED -- every jbe/ja with a LAZY flag state took the wrong branch, which
	          * cost the 200 M boot its final state (a `jbe` jumped into the middle of the
	          * loop it was bounding). */
		jx64_call_label(e, jitcg_sh.getcf);
		jx64_mov_r32_r32(e, JC_VAL, JX_RDI);
		jx64_call_label(e, jitcg_sh.getzf);
		jx64_or_r32_r32(e, JX_RDI, JC_VAL);
		break;
	}
	jx64_test_r32_r32(e, JX_RDI, JX_RDI);
	/* the branch that SKIPS the taken path: `jcc` with the condition's own negation -- "taken
	 * means the flag is ZERO" for AE/NE/A, and "taken means the flag is SET" for E/B/BE. */
	not_taken = (cc == JX_CC_AE || cc == JX_CC_A || cc == JX_CC_NE) ? JX_CC_NE : JX_CC_E;
	jx64_jcc_label(e, not_taken, l_skip);
	jx64_mov_m32_imm32(e, JX_RBP, JC_OFF(instruction_pointer),
	                   u->eip + (uint32_t)u->len + (uint32_t)u->imm);
	jx64_bind(e, l_skip);
}

/* jmp rel8 / rel32 -- 0xEB / 0xE9: `ip += imm` from the instruction's end */
static void rec_jmp(jx64_t *e, const uop_t *u, int l_slow)
{
	(void)l_slow;
	jx64_mov_m32_imm32(e, JX_RBP, JC_OFF(instruction_pointer),
	                   u->eip + (uint32_t)u->len + (uint32_t)u->imm);
}

/* ------------------------------------------------------------------ *
 * the recipe table itself
 * ------------------------------------------------------------------ */

typedef struct jc_entry {
	void (*fn)(void);
	const char *name;
	uint8_t shape;
	uint8_t kind;   /* JIT_REC_* -- the emitter's own selector */
	uint8_t aux;    /* the digit / the register / the condition code */
	bool slow;      /* the emission has failure paths (see jit_recipe_t.slow) */
} jc_entry_t;

#define JIT_REC_MOV_RM_R32   1
#define JIT_REC_MOV_R32_RM   2
#define JIT_REC_MOVZX_R8     3
#define JIT_REC_MOVZX_R16    4
#define JIT_REC_MOV_R8_RM8   5
#define JIT_REC_MOV_RM8_R8   6
#define JIT_REC_MOV_RM16_R16 7
#define JIT_REC_MOV_R16_RM16 8
#define JIT_REC_LEA          9
#define JIT_REC_ALU_RM_REG  10
#define JIT_REC_ALU_RM_IMM8 11
#define JIT_REC_ALU_RM_IMM32 12
#define JIT_REC_TEST_RM_R32 13
#define JIT_REC_TEST_RM_IMM 14
#define JIT_REC_TEST_RM8_IMM 15
#define JIT_REC_NOT_RM32    16
#define JIT_REC_INC_REG     17
#define JIT_REC_DEC_REG     18
#define JIT_REC_MOV_IMM32   19
#define JIT_REC_NOP         20
#define JIT_REC_JCC         21
#define JIT_REC_JMP         22

static void jc_emit_recipe(jx64_t *e, const uop_t *u, const jc_entry_t *r, int l_slow)
{
	switch (r->kind) {
	case JIT_REC_MOV_RM_R32: rec_mov_rm_r32(e, u, l_slow); break;
	case JIT_REC_MOV_R32_RM: rec_mov_r32_rm(e, u, l_slow); break;
	case JIT_REC_MOVZX_R8: rec_movzx_r8(e, u, l_slow); break;
	case JIT_REC_MOVZX_R16: rec_movzx_r16(e, u, l_slow); break;
	case JIT_REC_MOV_R8_RM8: rec_mov_r8_rm8(e, u, l_slow); break;
	case JIT_REC_MOV_RM8_R8: rec_mov_rm8_r8(e, u, l_slow); break;
	case JIT_REC_MOV_RM16_R16: rec_mov_rm16_r16(e, u, l_slow); break;
	case JIT_REC_MOV_R16_RM16: rec_mov_r16_rm16(e, u, l_slow); break;
	case JIT_REC_LEA: rec_lea(e, u, l_slow); break;
	case JIT_REC_ALU_RM_REG: jitcg_emit_alu_rm(e, u, l_slow, r->aux, false, 0, false); break;
	case JIT_REC_ALU_RM_IMM8: jitcg_emit_alu_rm(e, u, l_slow, r->aux, true, u->imm, true); break;
	case JIT_REC_ALU_RM_IMM32: jitcg_emit_alu_rm(e, u, l_slow, r->aux, true, u->imm, false); break;
	case JIT_REC_TEST_RM_R32: rec_test_rm_r32(e, u, l_slow); break;
	case JIT_REC_TEST_RM_IMM: rec_test_rm_imm32(e, u, l_slow); break;
	case JIT_REC_TEST_RM8_IMM: rec_test_rm8_imm8(e, u, l_slow); break;
	case JIT_REC_NOT_RM32: rec_not_rm32(e, u, l_slow); break;
	case JIT_REC_INC_REG: rec_incdec_reg(e, u, l_slow, r->aux, false); break;
	case JIT_REC_DEC_REG: rec_incdec_reg(e, u, l_slow, r->aux, true); break;
	case JIT_REC_MOV_IMM32: rec_mov_r32_imm32(e, u, l_slow, r->aux); break;
	case JIT_REC_NOP: rec_nop(e, u, l_slow); break;
	case JIT_REC_JCC: rec_jcc(e, u, l_slow, r->aux); break;
	case JIT_REC_JMP: rec_jmp(e, u, l_slow); break;
	default: e->overflow = true; break;
	}
}

/* ONE recipe per ENCODING (the plan's ss7 step 2 preference: keyed on the body pointer, so
 * `uop_t` does not change), sorted by the pointer at build time so the lookup -- which happens
 * once per emitted uop, at COMPILE time -- is a binary search.  A recipe is valid for exactly
 * one SHAPE: that is what fixes its argument mapping, so a body reached through a shape the
 * recipe does not describe falls back instead of being mis-called. */
#define JC_R(fn_, name_, shape_, kind_, aux_, slow_) \
	{ (void (*)(void))(fn_), name_, UOP_SHAPE_##shape_, kind_, aux_, slow_ }

static const jc_entry_t jitcg_table[] = {
	JC_R(instr32_89_reg, "mov r/m32, r32 reg", REG0, JIT_REC_MOV_RM_R32, 0, false),
	JC_R(instr32_89_mem, "mov r/m32, r32 mem", MEM0, JIT_REC_MOV_RM_R32, 0, true),
	JC_R(instr32_8B_reg, "mov r32, r/m32 reg", REG0, JIT_REC_MOV_R32_RM, 0, false),
	JC_R(instr32_8B_mem, "mov r32, r/m32 mem", MEM0, JIT_REC_MOV_R32_RM, 0, true),
	JC_R(instr32_0FB6_reg, "movzx r32, r/m8 reg", REG0, JIT_REC_MOVZX_R8, 0, false),
