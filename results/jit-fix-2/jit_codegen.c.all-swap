	JC_R(instr32_85_reg, "test r/m32, r32 reg", REG0, JIT_REC_TEST_RM_R32, 0, false),
	JC_R(instr32_85_mem, "test r/m32, r32 mem", MEM0, JIT_REC_TEST_RM_R32, 0, true),
