/* inc/dec r32 (0x40-0x4F) and mov r32, imm32 (0xB8-0xBF): one recipe per encoding, the register
 * baked into the body.  Written as loops over the symbol names so the table stays a table. */
static void (*const jitcg_inc_fns[8])(void) = {
	(void (*)(void))instr32_40, (void (*)(void))instr32_41, (void (*)(void))instr32_42,
	(void (*)(void))instr32_43, (void (*)(void))instr32_44, (void (*)(void))instr32_45,
	(void (*)(void))instr32_46, (void (*)(void))instr32_47
};
static void (*const jitcg_dec_fns[8])(void) = {
	(void (*)(void))instr32_48, (void (*)(void))instr32_49, (void (*)(void))instr32_4A,
	(void (*)(void))instr32_4B, (void (*)(void))instr32_4C, (void (*)(void))instr32_4D,
	(void (*)(void))instr32_4E, (void (*)(void))instr32_4F
};
static void (*const jitcg_movimm_fns[8])(void) = {
	(void (*)(void))instr32_B8, (void (*)(void))instr32_B9, (void (*)(void))instr32_BA,
	(void (*)(void))instr32_BB, (void (*)(void))instr32_BC, (void (*)(void))instr32_BD,
	(void (*)(void))instr32_BE, (void (*)(void))instr32_BF
};
/* the 16 conditional-jump encodings: the index IS the condition code (0x70+cc / 0F 80+cc) */
static void (*const jitcg_jcc8_fns[16])(void) = {
	(void (*)(void))instr32_70, (void (*)(void))instr32_71, (void (*)(void))instr32_76,
	(void (*)(void))instr32_77, (void (*)(void))instr32_74, (void (*)(void))instr32_75,
	(void (*)(void))instr32_72, (void (*)(void))instr32_73, (void (*)(void))instr32_78,
	(void (*)(void))instr32_79, (void (*)(void))instr32_7A, (void (*)(void))instr32_7B,
	(void (*)(void))instr32_7C, (void (*)(void))instr32_7D, (void (*)(void))instr32_7E,
	(void (*)(void))instr32_7F
};
static void (*const jitcg_jcc32_fns[16])(void) = {
	(void (*)(void))instr32_0F80, (void (*)(void))instr32_0F81, (void (*)(void))instr32_0F86,
	(void (*)(void))instr32_0F87, (void (*)(void))instr32_0F84, (void (*)(void))instr32_0F85,
	(void (*)(void))instr32_0F82, (void (*)(void))instr32_0F83, (void (*)(void))instr32_0F88,
	(void (*)(void))instr32_0F89, (void (*)(void))instr32_0F8A, (void (*)(void))instr32_0F8B,
	(void (*)(void))instr32_0F8C, (void (*)(void))instr32_0F8D, (void (*)(void))instr32_0F8E,
	(void (*)(void))instr32_0F8F
};
/* the conditions this unit inlines: the four the hot code uses (CF and ZF and their
 * combinations).  The rest (S/NS/PE/PO/L/GE/LE/G, and O/NO) fall back to the C body. */
static bool jc_cc_supported(int cc)
{
	return cc == JX_CC_B || cc == JX_CC_AE || cc == JX_CC_E || cc == JX_CC_NE ||
	       cc == JX_CC_BE || cc == JX_CC_A;
}

static const char *const jc_cc_name[16] = {
	"jo", "jno", "jb", "jae", "je", "jne", "jbe", "ja",
	"js", "jns", "jp", "jnp", "jl", "jge", "jle", "jg"
};

static jc_entry_t jitcg_table_built[JC_MAX_RECIPES];
static uint32_t jitcg_ntable;
static bool jitcg_built;

static void jitcg_add(const jc_entry_t *e)
{
	if (jitcg_ntable >= JC_MAX_RECIPES) return;
	jitcg_table_built[jitcg_ntable++] = *e;
}

static void jitcg_build_recipes(void)
{
	if (jitcg_built) return;

	for (size_t i = 0; i < sizeof jitcg_table / sizeof jitcg_table[0]; i++) {
		jitcg_add(&jitcg_table[i]);
	}
	for (int i = 0; i < 8; i++) {
		jc_entry_t e;
		memset(&e, 0, sizeof e);
		e.fn = jitcg_inc_fns[i];
		e.name = "inc r32";
		e.shape = UOP_SHAPE_PLAIN0;
		e.kind = JIT_REC_INC_REG;
		e.aux = (uint8_t)i;
		jitcg_add(&e);

		e.fn = jitcg_dec_fns[i];
		e.name = "dec r32";
		e.kind = JIT_REC_DEC_REG;
		jitcg_add(&e);

		e.fn = jitcg_movimm_fns[i];
		e.name = "mov r32, imm32";
		e.shape = UOP_SHAPE_PLAIN1;
		e.kind = JIT_REC_MOV_IMM32;
		jitcg_add(&e);
	}
	for (int cc = 0; cc < 16; cc++) {
		jc_entry_t e;
		if (!jc_cc_supported(cc)) continue;
		memset(&e, 0, sizeof e);
		e.name = jc_cc_name[cc];
		e.kind = JIT_REC_JCC;
		e.aux = (uint8_t)cc;
		e.shape = UOP_SHAPE_PLAIN1;
		e.fn = jitcg_jcc8_fns[cc];
		jitcg_add(&e);
		e.fn = jitcg_jcc32_fns[cc];
		jitcg_add(&e);
	}

	/* keep the table sorted by the key, so the lookup is a binary search */
	for (uint32_t i = 1; i < jitcg_ntable; i++) {
		jc_entry_t key = jitcg_table_built[i];
		uint32_t j = i;
		while (j > 0 && (uintptr_t)jitcg_table_built[j - 1].fn > (uintptr_t)key.fn) {
			jitcg_table_built[j] = jitcg_table_built[j - 1];
			j--;
		}
		jitcg_table_built[j] = key;
	}
	jitcg_built = true;
}

static const jc_entry_t *jitcg_find(void (*fn)(void))
{
	uint32_t lo = 0, hi = jitcg_ntable;
	while (lo < hi) {
		uint32_t mid = lo + (hi - lo) / 2;
		uintptr_t a = (uintptr_t)jitcg_table_built[mid].fn;
		uintptr_t b = (uintptr_t)fn;
		if (a == b) return &jitcg_table_built[mid];
		if (a < b) lo = mid + 1;
		else hi = mid;
	}
	return NULL;
}

const jit_recipe_t *jit_recipe_lookup(const uop_t *u)
{
	static jit_recipe_t out;
	jitcg_build_recipes();
	const jc_entry_t *r = jitcg_find(u->fn);
	if (r == NULL) return NULL;
	/* the SHAPE (the argument mapping), and the decoded fields the recipe reads.  A memory
	 * recipe needs an address the emitter can compute: the 16-bit form (masked to 16 bits,
	 * a different arithmetic) has no recipe. */
	if (r->shape != u->shape) return NULL;
	if (jc_mem_shape(u->shape)) {
		if (u->addr_kind != UOP_ADDR_32 && u->addr_kind != UOP_ADDR_SIB) return NULL;
	}
	else if (u->shape == UOP_SHAPE_REG0 || u->shape == UOP_SHAPE_REG1 ||
	         u->shape == UOP_SHAPE_REGF0 || u->shape == UOP_SHAPE_REGF1) {
		if (!(u->flags & UOP_FLAG_IGNORE_MOD) && (u->modrm & 7) > 7) return NULL;
	}
	if (u->g > 7 && !(u->shape == UOP_SHAPE_REGF0 || u->shape == UOP_SHAPE_REGF1 ||
	                  u->shape == UOP_SHAPE_MEMF0 || u->shape == UOP_SHAPE_MEMF1 ||
	                  u->shape == UOP_SHAPE_PLAIN0 || u->shape == UOP_SHAPE_PLAIN1)) {
		return NULL;
	}
	out.fn = r->fn;
	out.name = r->name;
	out.shape = r->shape;
	out.slow = r->slow;
	out.kind = r->kind;
	out.aux = r->aux;
	return &out;
}

const char *jit_recipe_name(void (*fn)(void))
{
	jitcg_build_recipes();
	const jc_entry_t *r = jitcg_find(fn);
	return r == NULL ? NULL : r->name;
}

uint32_t jit_recipe_count(void)
{
	jitcg_build_recipes();
	return jitcg_ntable;
}

bool jit_codegen_available(void) { return true; }

/* ------------------------------------------------------------------ *
 * the machinery every uop uses
 * ------------------------------------------------------------------ */

/* the stores the executor does before the body (step 2) */
static void jitcg_emit_stores(jx64_t *e, const uop_t *u, bool any_pfx)
{
	jx64_mov_m32_imm32(e, JX_RBP, JC_OFF(previous_ip), u->eip);
	jx64_mov_m32_imm32(e, JX_RBP, JC_OFF(instruction_pointer), u->body_ip);
	if (any_pfx) jx64_mov_m8_imm8(e, JX_RBP, JC_OFF(prefixes), u->pfx);
}

/* THE SPILL / RELOAD PAIR (jit_codegen.h's comment): the eight guest registers and the pending
 * count, in both directions.  The reload also re-materialises the abort-flag address, because a
 * C call is free to clobber R8 (caller-saved) and the next uop's abort check reads it. */
static void jitcg_emit_spill(jx64_t *e)
{
	for (int i = 0; i < 8; i++) {
		jx64_mov_m32_r32(e, JX_RBP, JC_OFF(reg32) + 4 * i, jitcg_greg[i]);
	}
	jx64_mov_r64_imm64(e, JC_TMP, (uint64_t)(uintptr_t)&uop_pending);
	jx64_mov_m32_r32(e, JC_TMP, 0, JC_PENDING);
}

static void jitcg_emit_reload(jx64_t *e)
{
	for (int i = 0; i < 8; i++) {
		jx64_mov_r32_m32(e, jitcg_greg[i], JX_RBP, JC_OFF(reg32) + 4 * i);
	}
	jx64_mov_r64_imm64(e, JC_TMP, (uint64_t)(uintptr_t)&uop_pending);
	jx64_mov_r32_m32(e, JC_PENDING, JC_TMP, 0);
	jx64_mov_r64_imm64(e, JC_ABORT_REG, (uint64_t)(uintptr_t)&jit_abort_flag);
}

/* step 5's tail: the dispatch window's exit clear, and `prefixes = 0` */
static void jitcg_emit_post(jx64_t *e, bool any_pfx)
{
	jx64_mov_m8_imm8(e, JX_RBP, JC_OFF(pagefault), 0);
	if (any_pfx) jx64_mov_m8_imm8(e, JX_RBP, JC_OFF(prefixes), 0);
}

/* THE SHARED C FALLBACK: one per block, entered by `call` with RDI = the uop and ESI = its flag
 * word, and it returns to the instruction after that call (the uop's own tail).  It is
 * `uop_exec(u)` -- the executor's own per-uop worker -- so the shape switch, the task-switch
 * guard, the raw-modrm substitution for a custom_modrm_resolve encoding and the
 * materialisation-fault return are the C implementation rather than a transcription of it.
 *
 * RSP is 8 mod 16 on entry (it was `call`ed from the block's frame level), so `sub rsp, 8`
 * first: the SysV rule wants RSP 16-byte aligned AT the call, i.e. 0 mod 16 before it.  The
 * frame slots are at [rsp + 8 + off] on entry and [rsp + 16 + off] afterwards. */
static void jitcg_emit_slow(jx64_t *e, bool any_pfx)
{
	jx64_mov_m32_r32(e, JX_RSP, 8 + JC_FRAME_FLAGS, JX_RSI);
	jx64_sub_r64_imm8(e, JX_RSP, 8);
	jx64_mov_m8_imm8(e, JX_RBP, JC_OFF(pagefault), 0);
	jitcg_emit_spill(e);
	jx64_mov_r64_imm64(e, JC_TMP, (uint64_t)(uintptr_t)uop_exec_uop);
	jx64_call_r64(e, JC_TMP);
	jx64_movzx_r32_r8(e, JX_RDI, JX_RAX); /* uop_exec returns bool in AL */
	jx64_mov_r32_m32(e, JX_RSI, JX_RSP, 16 + JC_FRAME_FLAGS);
	jx64_shl_r32_imm8(e, JX_RDI, 2); /* ... into bit 2, "the body ran" */
	jx64_or_r32_r32(e, JX_RDI, JX_RSI);
	jx64_add_r64_imm8(e, JX_RSP, 8);
	jitcg_emit_reload(e);
	jitcg_emit_post(e, any_pfx);
	jx64_ret(e);
}

/* THE SHARED FLAG GETTERS.  getcf/getzf (flags.c:15-65), emitted code rather than calls into
 * flags.c -- they are what makes a jcc recipe and an inc/dec possible without a C call.  Each
 * returns 0/1 in EDI and clobbers only RSI/RDI/R11 (all of which the caller treats as dead:
 * the checks routine's arguments are materialised AFTER the body). */
static void jitcg_emit_getcf(jx64_t *e)
{
	int l_absent = jx64_label(e), l_done = jx64_label(e);

	jx64_test_rm32_imm32(e, jc_state(JC_OFF(flags_changed)), 1);
	jx64_jcc_label(e, JX_CC_E, l_absent);
	jx64_mov_r32_rm(e, JC_TMP, jc_state(JC_OFF(flags_changed)));
	jx64_sar_r32_imm8(e, JC_TMP, 31); /* the sub mask (flags_changed >> 31) */
	jx64_mov_r32_rm(e, JX_RDI, jc_state(JC_OFF(last_result)));
	jx64_xor_r32_r32(e, JX_RDI, JC_TMP);
	jx64_mov_r32_rm(e, JC_TMP2, jc_state(JC_OFF(last_op1)));
	jx64_xor_r32_r32(e, JC_TMP2, JC_TMP);
	jx64_cmp_r32_r32(e, JX_RDI, JC_TMP2);
	jx64_setcc_r8(e, JX_CC_B, JX_RDI);
	jx64_movzx_r32_r8(e, JX_RDI, JX_RDI);
	jx64_jmp_label(e, l_done);
	jx64_bind(e, l_absent);
	jx64_mov_r32_rm(e, JX_RDI, jc_state(JC_OFF(flags)));
	jx64_alu_rm_imm(e, 4, jc_reg(JX_RDI), 1, true);
	jx64_bind(e, l_done);
	jx64_ret(e);
}

static void jitcg_emit_getzf(jx64_t *e)
{
	int l_absent = jx64_label(e), l_done = jx64_label(e);

	jx64_test_rm32_imm32(e, jc_state(JC_OFF(flags_changed)), FLAG_ZERO);
	jx64_jcc_label(e, JX_CC_E, l_absent);
	/* (~last_result & (last_result - 1)) >> last_op_size & 1 -- `bt` is the variable shift
	 * without needing CL (CL is a live guest register) */
	jx64_mov_r32_rm(e, JX_RDI, jc_state(JC_OFF(last_result)));
	jx64_mov_r32_r32(e, JC_TMP2, JX_RDI);
	jx64_not_r32(e, JC_TMP2);
	jx64_dec_r32(e, JX_RDI);
	jx64_and_r32_r32(e, JX_RDI, JC_TMP2);
	jx64_mov_r32_rm(e, JC_TMP, jc_state(JC_OFF(last_op_size)));
	jx64_bt_r32_r32(e, JX_RDI, JC_TMP);
	jx64_setcc_r8(e, JX_CC_B, JX_RDI);
	jx64_movzx_r32_r8(e, JX_RDI, JX_RDI);
	jx64_jmp_label(e, l_done);
	jx64_bind(e, l_absent);
	jx64_mov_r32_rm(e, JX_RDI, jc_state(JC_OFF(flags)));
	jx64_test_r32_imm32(e, JX_RDI, FLAG_ZERO);
	jx64_setcc_r8(e, JX_CC_NE, JX_RDI);
	jx64_movzx_r32_r8(e, JX_RDI, JX_RDI);
	jx64_bind(e, l_done);
	jx64_ret(e);
}

/* ------------------------------------------------------------------ *
 * the shared checks routine, the exit stubs, the prologue and the epilogue
 * ------------------------------------------------------------------ */

/* the flush: `instruction_counter += pending; pending = 0` (uop_cache.c's uop_flush), PLUS the
 * executor's own tally of reproduced reference batch ends (uop_stats.flushes).  The tally is
 * maintained rather than left to the interpreted path on purpose: a counter that silently
 * means something different under --jit on is exactly the kind of instrument this project
 * treats as broken (results/perf-5-tune.md's method), and the flush count is the cheapest
 * independent check that both engines ended the same batches. */
static void jitcg_emit_flush(jx64_t *e)
{
	jx64_mov_r32_m32(e, JC_TMP, JX_RBP, JC_OFF(instruction_counter));
	jx64_add_r32_r32(e, JC_TMP, JC_PENDING);
	jx64_mov_m32_r32(e, JX_RBP, JC_OFF(instruction_counter), JC_TMP);
	jx64_xor_r32_r32(e, JC_PENDING, JC_PENDING);
	jx64_mov_r64_imm64(e, JC_TMP, (uint64_t)(uintptr_t)&uop_stats.flushes);
	jx64_add_m32_imm8(e, JC_TMP, 0, 1);
}

/* steps 6-11.  Reached by `call` (RSP is 8 bytes below the block's frame while it runs), which
 * is why every non-returning exit here first restores RSP with `add rsp, 8` -- and why the
 * per-uop abort check and the exit stubs OUTSIDE this routine do not. */
static void jitcg_emit_checks(jx64_t *e, int l_flush_return, int l_kind_return, int l_kind_tail,
                              int l_kind_blkend, int l_c2, int l_c4, int l_clear_jbc,
                              int l_ck_return, int l_ck_blkend, int l_ck_tail)
{
	/* 6. interpreted_unimplemented -> flush + RETURN (NOT gated on ran: the executor's own
	 * order, and the port's "the emulator cannot execute this" stop). */
	jx64_mov_r64_imm64(e, JC_TMP, (uint64_t)(uintptr_t)&interpreted_unimplemented);
	jx64_cmp_m8_imm8(e, JC_TMP, 0, 0);
	jx64_jcc_label(e, JX_CC_NE, l_flush_return);

	/* 7. `if (ran && ((FLUSH) || jit_block_boundary)) { flush; jbc = false; if budget RETURN }`.
	 * The condition is checked in the executor's own shape: `ran` gates the WHOLE arm, and a
	 * false `ran` must not clear jit_block_boundary either. */
	jx64_test_r8_imm8(e, JX_RDI, JC_F_RAN);
	jx64_jcc_label(e, JX_CC_E, l_c2);
	jx64_test_r8_imm8(e, JX_RDI, JC_F_FLUSH);
	jx64_jcc_label(e, JX_CC_NE, l_clear_jbc);
	jx64_mov_r64_imm64(e, JC_TMP, (uint64_t)(uintptr_t)&jit_block_boundary);
	jx64_cmp_m8_imm8(e, JC_TMP, 0, 0);
	jx64_jcc_label(e, JX_CC_E, l_c2);
	jx64_bind(e, l_clear_jbc);
	jx64_mov_r64_imm64(e, JC_TMP, (uint64_t)(uintptr_t)&jit_block_boundary);
	jx64_mov_m8_imm8(e, JC_TMP, 0, 0);
	jitcg_emit_flush(e);
	/* the budget check (do_many_cycles_native's window): `(int32)(counter - end) >= 0`.  EDI
	 * is pushed so it can be the scratch the two-operand subtraction needs -- the block's
	 * flags must survive to step 10. */
	jx64_push_r64(e, JX_RDI);
	jx64_mov_r64_imm64(e, JC_TMP, (uint64_t)(uintptr_t)&cpu_cycle_budget_end);
	jx64_mov_r32_m32(e, JX_RDI, JX_RBP, JC_OFF(instruction_counter));
	jx64_sub_r32_m32(e, JX_RDI, JC_TMP, 0);
	jx64_pop_r64(e, JX_RDI);
	jx64_jcc_label(e, JX_CC_NS, l_ck_return); /* SF == 0 <=> the wrapped difference >= 0 */

	jx64_bind(e, l_c2);
	/* 8. the page-crossing break (the reference's second clause: the instruction MOVED to
	 * another page), which is also the only way a diverging uop inside one page is not a
	 * tail. */
	jx64_mov_r32_m32(e, JC_TMP, JX_RBP, JC_OFF(instruction_pointer));
	jx64_xor_r32_r32(e, JC_TMP, JX_R10);
	jx64_test_r32_imm32(e, JC_TMP, 0xFFFFF000u);
	jx64_jcc_label(e, JX_CC_NE, l_flush_return);

	/* 9. the iteration limit, only reachable on a backward control transfer:
	 * `pending >= INTERPRETER_ITERATION_LIMIT && u->eip >= ip` (uop_cache.c's own line).
	 * MEASURED -- this was INVERTED (`ip >= eip`) from M1 through M2's first draft, and M1's
	 * gates could not see it: its programs are far shorter than the limit, and its boot ran
	 * only 0.32 % of its uops compiled.  At 89.9 % coverage the boot hits the limit with the
	 * compiled path constantly, and the inverted test ended a reference batch on every
	 * FORWARD branch at the limit -- a staircase shift that cost the 200 M boot its final
	 * state (eip 0x21972ee vs 0x21972c1 after the same instruction count). */
	jx64_cmp_r32_imm32(e, JC_PENDING, (int32_t)INTERPRETER_ITERATION_LIMIT);
	jx64_jcc_label(e, JX_CC_B, l_c4);
	jx64_mov_r32_m32(e, JC_TMP, JX_RBP, JC_OFF(instruction_pointer));
	jx64_cmp_r32_r32(e, JC_TMP, JX_R10);
	jx64_jcc_label(e, JX_CC_BE, l_flush_return);
	jx64_bind(e, l_c4);

	/* 10. the block end (the BLOCK_END uop: the block stops HERE, and whether that is also a
	 * reference batch end is what bit0 of EDI said in step 7) */
	jx64_test_r8_imm8(e, JX_RDI, JC_F_BLOCK_END);
	jx64_jcc_label(e, JX_CC_NE, l_ck_blkend);

	/* 11. the divergence test: the executor compares against `eip + len`, NOT against
	 * body_ip -- a custom_modrm_resolve body (0x8D/0x8F) consumes its own sib/disp bytes and
	 * leaves the pointer at the instruction's end, which is what ESI carries. */
	jx64_cmp_m32_r32(e, JX_RBP, JC_OFF(instruction_pointer), JX_RSI);
	jx64_jcc_label(e, JX_CC_NE, l_ck_tail);

	jx64_ret(e);

	/* --- the exits.  Reached ONLY from inside this routine, so each restores RSP first. */
	jx64_bind(e, l_ck_return);
	jx64_add_r64_imm8(e, JX_RSP, 8);
	jx64_jmp_label(e, l_kind_return);
	jx64_bind(e, l_ck_blkend);
	jx64_add_r64_imm8(e, JX_RSP, 8);
	jx64_jmp_label(e, l_kind_blkend);
	jx64_bind(e, l_ck_tail);
	jx64_add_r64_imm8(e, JX_RSP, 8);
	jx64_jmp_label(e, l_kind_tail);
}

static void jitcg_emit_prologue(jx64_t *e, bool need_slots, bool need_code)
{
	jx64_push_r64(e, JX_RBP);
	jx64_push_r64(e, JX_RBX);
	jx64_push_r64(e, JX_R12);
	jx64_push_r64(e, JX_R13);
	jx64_push_r64(e, JX_R14);
	jx64_push_r64(e, JX_R15);
	jx64_sub_r64_imm8(e, JX_RSP, JC_FRAME_BYTES);

	jx64_mov_r64_imm64(e, JX_RBP, (uint64_t)(uintptr_t)cpu);
	for (int i = 0; i < 8; i++) {
		jx64_mov_r32_m32(e, jitcg_greg[i], JX_RBP, JC_OFF(reg32) + 4 * i);
	}
	jx64_mov_r64_imm64(e, JC_TMP, (uint64_t)(uintptr_t)&uop_pending);
	jx64_mov_r32_m32(e, JC_PENDING, JC_TMP, 0);
	jx64_mov_r64_imm64(e, JC_ABORT_REG, (uint64_t)(uintptr_t)&jit_abort_flag);

	jx64_mov_m32_imm32(e, JX_RSP, JC_FRAME_EXEC, 0);
	jx64_mov_m32_imm32(e, JX_RSP, JC_FRAME_INLINED, 0);
	jx64_mov_m32_imm32(e, JX_RSP, JC_FRAME_KIND, 0);
	/* the D1 window's entry clear, hoisted to the block entry: with a clear also after every
	 * CALLED body the flag is false at every uop boundary, which is what the executor's
	 * per-uop entry clear establishes (this file's header argues the equivalence). */
	jx64_mov_m8_imm8(e, JX_RBP, JC_OFF(pagefault), 0);

	/* the addresses the inlined memory access needs, loaded once per block (see the frame
	 * layout): tlb_data is a link-time constant, the other three are read through their own
	 * addresses so a value that changes later is re-read rather than cached. */
	if (need_slots) {
		jx64_mov_r64_imm64(e, JC_TMP, (uint64_t)(uintptr_t)tlb_data);
		jx64_mov_m64_r64(e, JX_RSP, JC_FRAME_TLB, JC_TMP);
		jx64_mov_r64_imm64(e, JC_TMP, (uint64_t)(uintptr_t)&mem8);
		jx64_mov_m64_r64(e, JX_RSP, JC_FRAME_MEM8, JC_TMP);
	}
	if (need_code) {
		jx64_mov_r64_imm64(e, JC_TMP, (uint64_t)(uintptr_t)&uop_page_code);
		jx64_mov_r64_m64(e, JC_TMP, JC_TMP, 0);
		jx64_mov_m64_r64(e, JX_RSP, JC_FRAME_CODE, JC_TMP);
		jx64_mov_r64_imm64(e, JC_TMP, (uint64_t)(uintptr_t)&uop_page_code_len);
		jx64_mov_r32_m32(e, JC_TMP, JC_TMP, 0);
		jx64_mov_m32_r32(e, JX_RSP, JC_FRAME_CODELEN, JC_TMP);
	}
}

static void jitcg_emit_epilogue(jx64_t *e)
{
	/* the pending count goes back to its global (the executor's own storage) */
	jx64_mov_r64_imm64(e, JC_TMP, (uint64_t)(uintptr_t)&uop_pending);
	jx64_mov_m32_r32(e, JC_TMP, 0, JC_PENDING);

	/* ... the guest registers go back to cpu->reg32[] ... */
	for (int i = 0; i < 8; i++) {
		jx64_mov_m32_r32(e, JX_RBP, JC_OFF(reg32) + 4 * i, jitcg_greg[i]);
	}

	/* ... and the counters are folded in ONCE per block run (the executor's PERF-5 hoist):
	 * uop_stats.uops_executed += executed, and the coverage split -- inlined = the recipe
	 * uops that ran, called = the rest.  A 64-bit add, so this cannot wrap where the C path
	 * would not. */
	jx64_mov_r32_m32(e, JC_TMP, JX_RSP, JC_FRAME_EXEC);
	jx64_mov_r32_m32(e, JX_R10, JX_RSP, JC_FRAME_INLINED);
	jx64_mov_r64_imm64(e, JX_RDI, (uint64_t)(uintptr_t)&uop_stats.uops_executed);
	jx64_add_m64_r64(e, JX_RDI, 0, JC_TMP);
	jx64_mov_r64_imm64(e, JX_RDI, (uint64_t)(uintptr_t)&jit_codegen_stats.inlined_uops);
	jx64_add_m64_r64(e, JX_RDI, 0, JX_R10);
	jx64_sub_r32_r32(e, JC_TMP, JX_R10);
	jx64_mov_r64_imm64(e, JX_RDI, (uint64_t)(uintptr_t)&jit_codegen_stats.called_uops);
	jx64_add_m64_r64(e, JX_RDI, 0, JC_TMP);

	jx64_mov_r32_m32(e, JX_RAX, JX_RSP, JC_FRAME_KIND); /* the exit kind, AFTER the spill */
	jx64_add_r64_imm8(e, JX_RSP, JC_FRAME_BYTES);
	jx64_pop_r64(e, JX_R15);
	jx64_pop_r64(e, JX_R14);
	jx64_pop_r64(e, JX_R13);
	jx64_pop_r64(e, JX_R12);
	jx64_pop_r64(e, JX_RBX);
	jx64_pop_r64(e, JX_RBP);
	jx64_ret(e);
}

/* ------------------------------------------------------------------ *
 * one uop
 * ------------------------------------------------------------------ */

static const uop_t *uops_base;

static void jitcg_emit_uop(jx64_t *e, const uop_t *u, const jc_entry_t *rec, bool any_pfx,
                           int l_kind_abort, int l_checks)
{
	int flags = 0;
	int l_slow = -1, l_tail = -1;

	if (u->flags & UOP_FLAG_FLUSH) flags |= JC_F_FLUSH;
	if (u->flags & UOP_FLAG_BLOCK_END) flags |= JC_F_BLOCK_END;

	/* step 1: the abort check, before any of this uop's work (the executor's own order) */
	jx64_cmp_m8_imm8(e, JC_ABORT_REG, 0, 0);
	jx64_jcc_label(e, JX_CC_NE, l_kind_abort);

	/* steps 2-3 */
	jitcg_emit_stores(e, u, any_pfx);

	if (rec != NULL && rec->kind != 0) {
		if (getenv("JITCG_DUMP")) {
			fprintf(stderr, "jitcg:     uop %u code at byte %zu\n", (unsigned)(u - uops_base),
			        e->n);
		}
		/* the recipe's failure continuations, allocated only when the emission can fail
		 * (jit_recipe_t.slow): an infallible recipe emits no trampoline at all. */
		if (rec->slow) {
			l_slow = jx64_label(e);
			l_tail = jx64_label(e);
		}
		jc_emit_recipe(e, u, rec, l_slow);
		/* STEP 5's `prefixes = 0`, on the RECIPE path too.  A recipe that ran under a prefix
		 * byte (a segment override, say) left cpu->prefixes set, and the reference's own
		 * block-entry invariant -- `DBG_ASSERT(cpu->prefixes == 0)` in uop_decode_block -- then
		 * fired on the next decode.  MEASURED: the 200 M boot aborted at eip 0x21972f7 after
		 * 876,568 instructions.  The CALLED path gets this from jitcg_emit_post in the shared
		 * stub; the fast path has to emit it. */
		if (any_pfx) jx64_mov_m8_imm8(e, JX_RBP, JC_OFF(prefixes), 0);
		jx64_mov_r32_imm32(e, JX_RDI, (uint32_t)(flags | JC_F_RAN));
		jx64_add_m32_imm8(e, JX_RSP, JC_FRAME_INLINED, 1);
		if (rec->slow) {
			jx64_jmp_label(e, l_tail);
			jx64_bind(e, l_slow);
			jx64_mov_r64_imm64(e, JX_RDI, (uint64_t)(uintptr_t)u);
			jx64_mov_r32_imm32(e, JX_RSI, (uint32_t)flags);
			jx64_call_label(e, jitcg_sh.l_slow);
			jx64_bind(e, l_tail);
		}
	}
	else {
		jx64_mov_r64_imm64(e, JX_RDI, (uint64_t)(uintptr_t)u);
		jx64_mov_r32_imm32(e, JX_RSI, (uint32_t)flags);
		jx64_call_label(e, jitcg_sh.l_slow);
	}

	/* step 5's counts.  `block_uops += 1` happens AFTER the abort check in the executor,
	 * which is why the abort exit must not have counted this uop -- here the frame slot is
	 * only incremented on the fall-through path, so an abort exit leaves it holding exactly
	 * the uops that ran. */
	jx64_add_m32_imm8(e, JX_RSP, JC_FRAME_EXEC, 1);
	jx64_inc_r32(e, JC_PENDING);

	/* steps 6-11, in the shared routine */
	jx64_mov_r32_imm32(e, JX_RSI, u->eip + u->len);
	jx64_mov_r32_imm32(e, JX_R10, u->eip);
	jx64_call_label(e, l_checks);
}

/* ------------------------------------------------------------------ *
 * the compiler
 * ------------------------------------------------------------------ */

uint8_t *jit_compile_block(const uop_t *uops, uint32_t count, uint32_t phys, uint32_t virt,
                           uint8_t state)
{
	jit_codegen_stats.compile_attempts++;

	if (count == 0 || count > UOP_MAX_BLOCK_UOPS) {
		jit_codegen_stats.refused_noblock++;
		return NULL;
	}

	/* REUSE BEFORE COMPILING.  A block can outlive its uop-cache record: the cache's own
	 * clear (an arena/block overflow) drops decoded blocks without any guest write, and the
	 * guest's bytes are unchanged, so the compiled block is still valid and must be FOUND
	 * rather than recompiled -- a recompile would take a second code allocation for the same
	 * key and the first one could never be freed.  This is a COMPILE-time lookup: the run
	 * path reads the code pointer the block record already carries (no double hash). */
	uint8_t *have = jit_cache_lookup(phys, virt, state);
	if (have != NULL) {
		jit_codegen_stats.blocks_reused++;
		return have;
	}

	/* THE PRE-PASS: which recipes the block's uops have, and therefore which shared
	 * routines and prologue slots the emission needs.  The recipe lookup is compile-time
	 * only, so it happens here and nowhere near a run path. */
	const jc_entry_t *recs[UOP_MAX_BLOCK_UOPS];
	bool any_pfx = false, need_slots = false, need_code = false, need_slow = false;
	bool need_cf = false, need_zf = false;

	jitcg_build_recipes();
	for (uint32_t i = 0; i < count; i++) {
		const uop_t *u = &uops[i];
		const jit_recipe_t *r = jit_recipe_lookup(u);
		recs[i] = r == NULL ? NULL : jitcg_find(r->fn);
		if (u->pfx != 0) any_pfx = true;
		if (recs[i] == NULL) {
			need_slow = true;
			continue;
		}
		if (recs[i]->slow) need_slow = true;
		if (jc_mem_shape(recs[i]->shape)) {
			if (recs[i]->kind != JIT_REC_LEA) need_slots = true;
			if (recs[i]->kind != JIT_REC_LEA) {
				/* a memory recipe that WRITES goes through the code-page gate */
				switch (recs[i]->kind) {
				case JIT_REC_MOV_RM_R32:
				case JIT_REC_MOV_RM8_R8:
				case JIT_REC_MOV_RM16_R16:
					need_code = true;
					break;
				case JIT_REC_ALU_RM_REG:
				case JIT_REC_ALU_RM_IMM8:
				case JIT_REC_NOT_RM32:
					if (recs[i]->aux != 7) need_code = true;
					break;
				default:
					break;
				}
			}
		}
		switch (recs[i]->kind) {
		case JIT_REC_INC_REG:
		case JIT_REC_DEC_REG:
			need_cf = true;
			break;
		case JIT_REC_JCC:
			if (recs[i]->aux == JX_CC_B || recs[i]->aux == JX_CC_AE) need_cf = true;
			else if (recs[i]->aux == JX_CC_E || recs[i]->aux == JX_CC_NE) need_zf = true;
			else {
				need_cf = true;
				need_zf = true;
			}
			break;
		default:
			break;
		}
	}

	jx64_t e;
	jx64_init(&e, jitcg_scratch, sizeof jitcg_scratch);

	int l_epilogue = jx64_label(&e);
	int l_kind_return = jx64_label(&e);
	int l_kind_tail = jx64_label(&e);
	int l_kind_abort = jx64_label(&e);
	int l_kind_blkend = jx64_label(&e);
	int l_flush_return = jx64_label(&e);
	int l_checks = jx64_label(&e);
	int l_c2 = jx64_label(&e);
	int l_c4 = jx64_label(&e);
	int l_clear_jbc = jx64_label(&e);
	int l_ck_return = jx64_label(&e);
	int l_ck_blkend = jx64_label(&e);
	int l_ck_tail = jx64_label(&e);

	jitcg_sh.state = state;
	jitcg_sh.l_slow = jx64_label(&e);
	jitcg_sh.getcf = need_cf ? jx64_label(&e) : -1;
	jitcg_sh.getzf = need_zf ? jx64_label(&e) : -1;

	jitcg_emit_prologue(&e, need_slots, need_code);
	uops_base = uops;

	for (uint32_t i = 0; i < count; i++) {
		const uop_t *u = &uops[i];
		if (recs[i] != NULL) jit_codegen_stats.uops_with_recipe++;
		else jit_codegen_stats.uops_without_recipe++;
		jitcg_emit_uop(&e, u, recs[i], any_pfx, l_kind_abort, l_checks);
	}

	/* THE BLOCK RAN OUT OF UOPS (the executor's `idx += 1; if (idx >= count) why = TAIL`):
	 * the last uop's checks routine returns here on the fall-through path, and the reference
	 * has no boundary at a cap end -- so the tail, then a fresh lookup at the new eip.  This
	 * is also what keeps the emission from falling into the shared routines below. */
	jx64_jmp_label(&e, l_kind_tail);

	jx64_bind(&e, l_checks);
	jitcg_emit_checks(&e, l_flush_return, l_kind_return, l_kind_tail, l_kind_blkend, l_c2,
	                  l_c4, l_clear_jbc, l_ck_return, l_ck_blkend, l_ck_tail);

	/* the flush-without-a-budget-check stub (steps 6, 8 and 9 all end a reference batch and
	 * return; only step 7 checks the window, because only there is the reference's batch end
	 * the place do_many_cycles_native stops) */
	jx64_bind(&e, l_flush_return);
	jx64_add_r64_imm8(&e, JX_RSP, 8); /* this one is reached from INSIDE the routine */
	jitcg_emit_flush(&e);
	jx64_jmp_label(&e, l_kind_return);

	/* THE SHARED ROUTINES: each is entered by `call` (or is unreachable) and each ends in
	 * `ret`, so the emission can fall from one into the next without a jump. */
	if (need_cf) {
		jx64_bind(&e, jitcg_sh.getcf);
		jitcg_emit_getcf(&e);
	}
	if (need_zf) {
		jx64_bind(&e, jitcg_sh.getzf);
		jitcg_emit_getzf(&e);
	}
	if (need_slow) {
		jx64_bind(&e, jitcg_sh.l_slow);
		jitcg_emit_slow(&e, any_pfx);
	}

	jx64_bind(&e, l_kind_return);
	jx64_mov_m32_imm32(&e, JX_RSP, JC_FRAME_KIND, JIT_EXIT_RETURN);
	jx64_jmp_label(&e, l_epilogue);
	jx64_bind(&e, l_kind_tail);
	jx64_mov_m32_imm32(&e, JX_RSP, JC_FRAME_KIND, JIT_EXIT_TAIL);
	jx64_jmp_label(&e, l_epilogue);
	jx64_bind(&e, l_kind_abort);
	jx64_mov_m32_imm32(&e, JX_RSP, JC_FRAME_KIND, JIT_EXIT_ABORT);
	jx64_jmp_label(&e, l_epilogue);
	jx64_bind(&e, l_kind_blkend);
	jx64_mov_m32_imm32(&e, JX_RSP, JC_FRAME_KIND, JIT_EXIT_BLOCK_END);
	jx64_jmp_label(&e, l_epilogue);

	jx64_bind(&e, l_epilogue);
	jitcg_emit_epilogue(&e);

	/* THE FIT RULE, and every other refusal.  `jx64_finish` fails on an overflow (more code
	 * than JIT_CODE_MAX_BLOCK_BYTES), an unbound label, an invalid label id, or a
	 * displacement that does not fit in 32 bits -- in EVERY case nothing is published and the
	 * block keeps its uop execution. */
	if (!jx64_finish(&e)) {
		jit_codegen_stats.refused_fit++;
		jit_codegen_stats.refused_fit_uops += count;
		return NULL;
	}
	uint32_t len = (uint32_t)jx64_len(&e);
	if (len == 0 || len > JIT_CODE_MAX_BLOCK_BYTES) {
		jit_codegen_stats.refused_fit++;
		jit_codegen_stats.refused_fit_uops += count;
		return NULL;
	}

	if (getenv("JITCG_DUMP")) {
		char pth[64]; FILE *f; snprintf(pth, sizeof pth, "/tmp/block-%08x-%u.bin", phys, len); f = fopen(pth, "wb");
		fprintf(stderr, "jitcg: block %u uops at %08x/%08x state %02x, %u bytes\n", count, phys,
		        virt, state, len);
		if (f) { fwrite(jitcg_scratch, 1, len, f); fclose(f); }
		for (uint32_t i = 0; i < count; i++) {
			const char *nm = jit_recipe_name(uops[i].fn);
			fprintf(stderr, "jitcg:   uop %u eip %08x shape %u addr %u base %u idx %u sc %u "
			                "disp %08x modrm %02x g %u seg %u rec %s\n", i, uops[i].eip,
			        uops[i].shape, uops[i].addr_kind, uops[i].base, uops[i].index,
			        uops[i].scale, (unsigned)uops[i].disp, uops[i].modrm, uops[i].g, uops[i].seg, nm ? nm : "-");
			fprintf(stderr, "jitcg:     flags %02x len %u\n", uops[i].flags, uops[i].len);
		}
	}
	uint8_t *page = jit_code_reserve_span(len);
	if (page == NULL) {
		jit_codegen_stats.refused_pool++;
		return NULL;
	}
	memcpy(page, jitcg_scratch, len);
	if (jit_code_publish(page, len) == NULL) {
		jit_codegen_stats.refused_pool++;
		return NULL;
	}
	if (!jit_cache_bind(phys, virt, state, page, len)) {
		jit_codegen_stats.refused_pool++;
		return NULL;
	}

	jit_codegen_stats.blocks_compiled++;
	jit_codegen_stats.compiled_uops += count;
	jit_codegen_stats.bytes_emitted += len;
	return page;
}

int jit_execute_block(uint8_t *code)
{
	jit_block_enter(code);
	int kind = ((int (*)(void))(void *)code)();
	jit_block_exit();
	return kind;
}

void jit_codegen_stats_print(void)
{
	uint64_t dyn = jit_codegen_stats.inlined_uops + jit_codegen_stats.called_uops;
	uint64_t sta = jit_codegen_stats.uops_with_recipe + jit_codegen_stats.uops_without_recipe;

	fprintf(stderr,
	        "jit: blocks compiled %llu in %llu attempts (reused %llu); refused: fit %llu "
	        "(%llu uops), pool %llu, empty %llu\n",
	        (unsigned long long)jit_codegen_stats.blocks_compiled,
	        (unsigned long long)jit_codegen_stats.compile_attempts,
	        (unsigned long long)jit_codegen_stats.blocks_reused,
	        (unsigned long long)jit_codegen_stats.refused_fit,
	        (unsigned long long)jit_codegen_stats.refused_fit_uops,
	        (unsigned long long)jit_codegen_stats.refused_pool,
	        (unsigned long long)jit_codegen_stats.refused_noblock);
	fprintf(stderr, "jit: block sizes: compiled %llu uops in %llu bytes (mean %.1f B/uop, "
	                "%.1f uops/block); refused-for-fit %llu uops in %llu blocks (mean %.1f)\n",
	        (unsigned long long)jit_codegen_stats.compiled_uops,
	        (unsigned long long)jit_codegen_stats.bytes_emitted,
	        jit_codegen_stats.compiled_uops
	            ? (double)jit_codegen_stats.bytes_emitted / (double)jit_codegen_stats.compiled_uops
	            : 0.0,
	        jit_codegen_stats.blocks_compiled
	            ? (double)jit_codegen_stats.compiled_uops / (double)jit_codegen_stats.blocks_compiled
	            : 0.0,
	        (unsigned long long)jit_codegen_stats.refused_fit_uops,
	        (unsigned long long)jit_codegen_stats.refused_fit,
	        jit_codegen_stats.refused_fit
	            ? (double)jit_codegen_stats.refused_fit_uops / (double)jit_codegen_stats.refused_fit
	            : 0.0);
	fprintf(stderr,
	        "jit: uops executed inlined %llu / called %llu -> %.2f%% dynamic inlined "
	        "(compile-time: %llu with a recipe, %llu without)\n",
	        (unsigned long long)jit_codegen_stats.inlined_uops,
	        (unsigned long long)jit_codegen_stats.called_uops,
	        dyn ? 100.0 * (double)jit_codegen_stats.inlined_uops / (double)dyn : 0.0,
	        (unsigned long long)jit_codegen_stats.uops_with_recipe,
	        (unsigned long long)jit_codegen_stats.uops_without_recipe);
	fprintf(stderr, "jit: recipe table: %u entries over %u emitted uops\n",
	        jit_recipe_count(),
	        (unsigned)jit_codegen_stats.compiled_uops);
	if (sta == 0) {
		fprintf(stderr, "jit: no uop was emitted (nothing was compiled)\n");
	}
}

#else /* !V86C_JIT_X64 -- THE aarch64 / any-other-arch POSTURE (jit_codegen.h) */

jit_codegen_stats_t jit_codegen_stats;

bool jit_codegen_available(void) { return false; }
uint32_t jit_recipe_count(void) { return 0; }
const jit_recipe_t *jit_recipe_lookup(const uop_t *u)
{
	(void)u;
	return NULL;
}
const char *jit_recipe_name(void (*fn)(void))
{
	(void)fn;
	return NULL;
}
uint8_t *jit_compile_block(const uop_t *uops, uint32_t count, uint32_t phys, uint32_t virt,
                           uint8_t state)
{
	(void)uops; (void)count; (void)phys; (void)virt; (void)state;
	return NULL;
}
int jit_execute_block(uint8_t *code)
{
	(void)code;
	return JIT_EXIT_RETURN;
}
void jit_codegen_stats_print(void)
{
	fprintf(stderr, "jit: no x86-64 backend on this architecture: no block is compiled\n");
}

#endif /* V86C_JIT_X64 */
