	JC_R(instr32_0FB7_reg, "movzx r32, r/m16 reg", REG0, JIT_REC_MOVZX_R16, 0, false),
	JC_R(instr32_0FB7_mem, "movzx r32, r/m16 mem", MEM0, JIT_REC_MOVZX_R16, 0, true),
	JC_R(instr_8A_reg, "mov r8, r/m8 reg", REG0, JIT_REC_MOV_R8_RM8, 0, false),
